{
	"name": "nestjs-boilerplate",
	"private": true,
	"version": "0.0.1",
	"description": "A NestJS boilerplate",
	"author": "D-Pow",
	"license": "UNLICENSED",
	"scripts": {
		"start": "nest start --debug 0.0.0.0:9229 --watch",
		"start:prod": "npm run build && CLUSTER=true node dist/main",
		"build": "nest build",
		"lint": "eslint",
		"lint:fix": "npm run lint -- --fix",
		"lint:verify": "npm run lint -- --quiet",
		"test": "jest",
		"test:unit": "jest src",
		"test:api": "jest test",
		"test:watch": "jest --watch",
		"test:cov": "jest --coverage",
		"test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
		"typecheck": "tsc --noEmit",
		"verify": "set -m; declare exitCode=0; ( npm run lint:verify ) & ( npm run typecheck ) & ( npm run test ) & for bgPid in $(jobs -p); do wait $bgPid; (( exitCode += $? )); done; exit $exitCode"
	},
	"jest": {
		"preset": "./config/jest.config.mjs"
	},
	"overrides": {
		"eslint": "$eslint"
	},
	"dependencies": {
		"@nestjs/common": "^12.0.1",
		"@nestjs/core": "^12.0.1",
		"@nestjs/platform-express": "^12.0.1",
		"@nestjs/swagger": "^12.0.1",
		"class-transformer": "^0.5.1",
		"class-validator": "^0.15.1",
		"reflect-metadata": "^0.2.2"
	},
	"devDependencies": {
		"@eslint/eslintrc": "^3.2.0",
		"@eslint/js": "^9.18.0",
		"@nestjs/cli": "^12.0.0",
		"@nestjs/schematics": "^12.0.0",
		"@nestjs/testing": "^12.0.1",
		"@stylistic/eslint-plugin": "^5.10.0",
		"@types/express": "^5.0.0",
		"@types/jest": "^30.0.0",
		"@types/node": "^24.0.0",
		"@types/supertest": "^7.0.0",
		"eslint": "^10.5.0",
		"eslint-import-resolver-typescript": "^4.4.5",
		"eslint-plugin-import-alias": "^1.2.0",
		"eslint-plugin-import-x": "^4.17.1",
		"eslint-plugin-unused-imports": "^4.4.1",
		"globals": "^17.0.0",
		"jest": "^30.4.2",
		"source-map-support": "^0.5.21",
		"supertest": "^7.0.0",
		"ts-jest": "^29.4.11",
		"ts-loader": "^9.6.2",
		"ts-node": "^10.9.2",
		"tsconfig-paths": "^4.2.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.63.0"
	}
}
